# ===========================================================================
# 数据库连接配置模板（⚠️ 请勿提交真实密钥）
#
# 复制本文件为 .env 并按需填写真实值。真实连接凭据（尤其
# COZE_SUPABASE_SERVICE_ROLE_KEY）一旦推入公开仓库即等于泄露数据库权限，
# 请务必使用环境变量注入而非硬编码进代码/提交记录。
#
# 本项目支持两种数据通道，连接凭据均来自环境变量（运行时经
# coze_workload_identity 注入，或本地 .env）：
#   1) Supabase（前端业务主库）—— 由 src/storage/database/supabase-client.ts 读取
#   2) PostgreSQL（预警引擎/数据同步运行库）—— 由 src/lib/server/sync/sync-store.ts 读取
# ===========================================================================

# ---------------------------------------------------------------------------
# Supabase（业务主库）
# ---------------------------------------------------------------------------
# Supabase 项目 URL，形如 https://xxxx.supabase.co
COZE_SUPABASE_URL=

# Supabase anon/public key（前端可安全使用）
COZE_SUPABASE_ANON_KEY=

# Supabase service_role key（服务端全权密钥，⚠️ 高危，绝不提交到公开仓库）
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL（预警引擎 / 数据同步运行库）
# ---------------------------------------------------------------------------
# 推荐方式：完整连接串，优先级最高
PGDATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# 或逐项拆分：
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require          # 'disable' 关闭 SSL，默认 warn→require
PGCHANNELBINDING=

# ---------------------------------------------------------------------------
# 其它运行配置（可选）
# ---------------------------------------------------------------------------
# 数据同步任务鉴权密钥（tool.ts 默认用固定串，生产建议覆盖并配置请求方一致）
SYNC_SECRET_KEY=change-me